<UserControl x:Class="ZapretGui.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Style="{StaticResource PageTitle}" Text="Панель управления" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Ping:" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding PingMs, StringFormat={}{0} мс}" Foreground="{DynamicResource AccentGreen}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="{Binding UpdateStatus}" Command="{Binding CheckUpdatesCommand}" Padding="10,4" FontSize="12" ToolTip="Проверить обновления Zapret"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,12,0,12" Padding="14,10" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource AccentRedSoft}" BorderBrush="{DynamicResource AccentRed}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotAdmin}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" Text="Нет прав администратора: WinDivert может не загрузиться."/>
                <Button Grid.Column="1" Content="Перезапустить от администратора" Command="{Binding RestartAsAdminCommand}" Padding="12,6"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" VerticalAlignment="Center">
                    <Ellipse Width="44" Height="44">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource BgCardHover}"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentSoft}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <Ellipse Width="16" Height="16">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentGreen}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"><Run Text="Профиль: "/><Run Text="{Binding ProfileName, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}"/></TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Запустить" Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" MinWidth="110" Margin="0,0,10,0" ToolTip="Запустить (Ctrl+Alt+Z)"/>
                    <Button Content="Остановить" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" MinWidth="110" ToolTip="Остановить (Ctrl+Alt+Z)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Проверка доступности" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Text="Быстрый тест: отвечают ли сайты прямо сейчас"/>
                    </StackPanel>
                    <Button Content="Проверить" Command="{Binding CheckCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,6"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Targets}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6,8,0" Padding="10,6" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="ok"><Setter Property="Fill" Value="{DynamicResource AccentGreen}"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="fail"><Setter Property="Fill" Value="{DynamicResource AccentRed}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="18,12,12,10">
                    <TextBlock Text="Журнал" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Копировать" Command="{Binding CopyLogCommand}" Padding="10,4" FontSize="12" Margin="0,0,8,0"/>
                        <Button Content="Очистить" Command="{Binding ClearLogCommand}" Padding="10,4" FontSize="12"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalScrollBarVisibility="Auto" Background="{DynamicResource LogBg}" BorderThickness="0,1,0,0" Padding="18,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>