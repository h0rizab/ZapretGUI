<Window x:Class="ZapretGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZapretGui.ViewModels"
        xmlns:views="clr-namespace:ZapretGui.Views"
        Title="Zapret GUI" Height="720" Width="1000"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#1A2D2D30" Thickness="1" /></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,40" EndPoint="40,0" />
                                <LineGeometry StartPoint="-10,10" EndPoint="10,-10" />
                                <LineGeometry StartPoint="30,50" EndPoint="50,30" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,10,0,32">
                            <Grid Width="40" Height="40">
                                <Path Data="M 20,0 L 38,8 L 38,22 C 38,32 20,40 20,40 C 20,40 2,32 2,22 L 2,8 Z" Fill="{DynamicResource AccentGreen}" Stretch="Fill">
                                    <Path.Effect><DropShadowEffect Color="#FF00E676" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/></Path.Effect>
                                </Path>
                                <Path Data="M 18,8 L 10,22 L 20,22 L 16,34 L 28,18 L 18,18 Z" Fill="{DynamicResource BgDark}" Stretch="Fill" Margin="8,6,8,6"/>
                            </Grid>
                            <TextBlock Text="Zapret" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="GUI" FontSize="22" FontWeight="Black" Foreground="{DynamicResource AccentGreen}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Tag="&#xE80F;" Content="Панель управления" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE8FD;" Content="Профили" Command="{Binding NavigateCommand}" CommandParameter="Profiles"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" Tag="&#xE713;" Content="Настройки" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                    </StackPanel>
                    <Border Grid.Row="1" Padding="14,12" CornerRadius="{StaticResource RadiusMd}" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dashboard.IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentGreen}"/>
                                                <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FF00E676" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/></Setter.Value></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Dashboard.StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <ContentControl Grid.Column="1" Margin="32" Content="{Binding CurrentView, NotifyOnTargetUpdated=True}" RenderTransformOrigin="0.5,0.5">
                <ContentControl.RenderTransform><TransformGroup><TranslateTransform Y="15"/></TransformGroup></ContentControl.RenderTransform>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView/></DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>